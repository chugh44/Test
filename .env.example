# LLM reasoning (optional — without it, rule-based fallbacks are used and labeled)
ANTHROPIC_API_KEY=
STOCKINTEL_MODEL=claude-opus-5-5
# Set to 0 to disable Claude web search in the news / macro agents
STOCKINTEL_WEB_SEARCH=1

# Optional data providers
FINNHUB_API_KEY=
NEWSAPI_KEY=
FRED_API_KEY=

# Storage
STOCKINTEL_DB=stockintel.db

# Forecasting
STOCKINTEL_BACKTEST_FOLDS=6
STOCKINTEL_ENABLE_LSTM=1
STOCKINTEL_ENABLE_PROPHET=1
